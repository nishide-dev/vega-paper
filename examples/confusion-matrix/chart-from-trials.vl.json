{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "trials.csv",
    "format": {
      "type": "csv",
      "parse": {
        "n": "number"
      }
    }
  },
  "mark": "rect",
  "width": 360,
  "height": 240,
  "encoding": {
    "x": {
      "field": "predicted",
      "type": "ordinal"
    },
    "y": {
      "field": "actual",
      "type": "ordinal"
    },
    "color": {
      "field": "n",
      "type": "quantitative"
    }
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "n",
          "as": "n"
        }
      ],
      "groupby": [
        "predicted",
        "actual"
      ]
    }
  ],
  "title": "Confusion matrix (from trials)"
}
