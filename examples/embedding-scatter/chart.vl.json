{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "data.csv"
  },
  "mark": "point",
  "width": 360,
  "height": 360,
  "encoding": {
    "x": {
      "field": "x",
      "type": "quantitative"
    },
    "y": {
      "field": "y",
      "type": "quantitative"
    },
    "color": {
      "field": "label",
      "type": "nominal"
    }
  },
  "title": "Embedding (2D)"
}
