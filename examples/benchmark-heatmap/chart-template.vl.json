{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "data.csv"
  },
  "width": 420,
  "height": 240,
  "layer": [
    {
      "mark": "rect",
      "encoding": {
        "x": {
          "field": "task",
          "type": "ordinal"
        },
        "y": {
          "field": "model",
          "type": "ordinal"
        },
        "color": {
          "field": "score",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": "text",
      "encoding": {
        "x": {
          "field": "task",
          "type": "ordinal"
        },
        "y": {
          "field": "model",
          "type": "ordinal"
        },
        "text": {
          "field": "score",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "task": "MMLU",
            "model": "Ours"
          },
          {
            "task": "GSM8K",
            "model": "Ours"
          },
          {
            "task": "HellaSwag",
            "model": "Ours"
          },
          {
            "task": "ARC",
            "model": "Ours"
          },
          {
            "task": "HumanEval",
            "model": "Ours"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "fill": null,
        "stroke": "#1a1a1a",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "task",
          "type": "ordinal"
        },
        "y": {
          "field": "model",
          "type": "ordinal"
        }
      }
    }
  ],
  "title": "Benchmark results"
}
