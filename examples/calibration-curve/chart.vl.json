{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "data.csv"
  },
  "width": 360,
  "height": 240,
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#888888",
        "strokeDash": [
          4,
          4
        ]
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "y": {
          "datum": 0
        },
        "x2": {
          "datum": 1
        },
        "y2": {
          "datum": 1
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "point": false
      },
      "encoding": {
        "x": {
          "field": "confidence",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "y": {
          "field": "accuracy",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true
      },
      "encoding": {
        "x": {
          "field": "confidence",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "y": {
          "field": "accuracy",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "size": {
          "field": "count",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top"
      },
      "encoding": {
        "x": {
          "datum": 0.05
        },
        "y": {
          "datum": 0.95
        },
        "text": {
          "value": "ECE = 0.041"
        }
      }
    }
  ],
  "title": "Reliability diagram"
