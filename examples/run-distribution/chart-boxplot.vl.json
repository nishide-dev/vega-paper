{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "data.csv"
  },
  "mark": "boxplot",
  "width": 360,
  "height": 240,
  "encoding": {
    "x": {
      "field": "method",
      "type": "nominal"
    },
    "y": {
      "field": "score",
      "type": "quantitative",
      "scale": {
        "zero": false
      }
    }
  },
  "title": "Score distribution over seeds"
}
