{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "data-with-error.csv"
  },
  "mark": "line",
  "width": 360,
  "height": 240,
  "encoding": {
    "x": {
      "field": "epoch",
      "type": "quantitative"
    },
    "y": {
      "field": "f1",
      "type": "quantitative"
    },
    "color": {
      "field": "model",
      "type": "nominal"
    },
    "yError": {
      "field": "f1_se",
      "type": "quantitative"
    }
  },
  "title": "Training F1 with standard error"
}
