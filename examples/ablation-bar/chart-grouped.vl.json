{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "grouped.csv"
  },
  "mark": "bar",
  "width": 420,
  "height": 240,
  "encoding": {
    "x": {
      "field": "dataset",
      "type": "nominal"
    },
    "y": {
      "field": "score",
      "type": "quantitative"
    },
    "color": {
      "field": "method",
      "type": "nominal"
    }
  },
  "title": "Accuracy by dataset"
}
