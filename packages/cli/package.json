{
  "name": "vega-paper",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "vega-paper": "./src/index.ts"
  },
  "scripts": {
    "build": "bun ../../scripts/run-if-sources.ts build -- bun build ./src/index.ts --outdir dist --target bun",
    "typecheck": "bun ../../scripts/run-if-sources.ts typecheck -- tsc --noEmit"
  },
  "dependencies": {
    "@vega-paper/themes": "workspace:*",
    "commander": "latest",
    "vega": "latest",
    "vega-cli": "latest",
    "vega-lite": "latest"
  }
}
