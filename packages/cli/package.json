{
  "name": "vega-paper",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "vega-paper": "./dist/index.js"
  },
  "files": [
    "dist/**"
  ],
  "publishConfig": {
    "bin": {
      "vega-paper": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/run-if-sources.ts build -- bun run --filter @vega-paper/themes build && bun build ./src/index.ts --outdir dist --target bun",
    "typecheck": "bun ../../scripts/run-if-sources.ts typecheck -- tsc --noEmit --types bun"
  },
  "dependencies": {
    "@vega-paper/themes": "workspace:*",
    "commander": "latest",
    "vega": "latest",
    "vega-cli": "latest",
    "vega-lite": "latest"
  }
}
